@@ -0,0 +1,32 @@
+import { PrismicPreview } from "@prismicio/next"
+import { cookies } from "next/headers"
+
+export const dynamic = "force-dynamic"
+
+type LayoutProps = {
+	children: React.ReactNode
+	params: Promise<{
+		repository: string
+	}>
+}
+
+export default async function InstantPreviewLayout(props: LayoutProps) {
+	const { repository } = await props.params
+	const cookieStore = await cookies()
+	const prismicHost = cookieStore.get(`prismicHost-${repository}`)?.value
+
+	const updatePreviewURL =
+		prismicHost ?
+			`/api/preview/${repository}?prismicHost=${encodeURIComponent(prismicHost)}`
+		:	`/api/preview/${repository}`
+
+	return (
+		<>
+			{props.children}
+			<PrismicPreview
+				repositoryName={repository}
+				updatePreviewURL={updatePreviewURL}
+			/>
+		</>
+	)
+}
