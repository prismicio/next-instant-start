+import { redirectToPreviewURL } from "@prismicio/next"
+import { NextRequest } from "next/server"
+
+import { createLinkResolver } from "@/lib/linkResolver"
+import { createClient } from "@/prismicio.tenant"
+
+export async function GET(
+	request: NextRequest,
+	context: RouteContext<"/[tenant]/api/preview">,
+) {
+	const { tenant } = await context.params
+	const client = createClient(tenant)
+	const linkResolver = createLinkResolver(`/${tenant}`)
+
+	return await redirectToPreviewURL({ client, request, linkResolver })
+}
