+import { PrismicPreview } from "@prismicio/next"
+import { Inter } from "next/font/google"
+import { notFound } from "next/navigation"
+
+import { resolveLocaleFromSegments } from "@/lib/locales"
+
+const inter = Inter({
+	subsets: ["latin"],
+	display: "swap",
+	variable: "--font-inter-family",
+})
+
+/**
+ * A root layout (see `src/app/(starter)/[[...lang]]/layout.tsx` for why),
+ * scoped to the tenant's own Prismic repository instead of the one
+ * configured in `prismic.config.json`.
+ */
+export default async function TenantLocaleLayout(
+	props: LayoutProps<"/[tenant]/[[...lang]]">,
+) {
+	const { children } = props
+	const { tenant, lang } = await props.params
+
+	const locale = resolveLocaleFromSegments(lang)
+	if (!locale) notFound()
+
+	const [repo] = tenant.split("~")
+
+	return (
+		<html lang={locale.code} className={inter.variable}>
+			<body className="font-sans bg-white text-[#0d0d0d] antialiased selection:bg-black selection:text-white">
+				<main className="min-h-screen">{children}</main>
+				<PrismicPreview
+					repositoryName={repo}
+					updatePreviewURL={`/${tenant}/api/preview`}
+				/>
+			</body>
+		</html>
+	)
+}
